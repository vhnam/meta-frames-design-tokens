        },
        "app": "JetBrainsMono"
      }
    },
    "paths": {
      "semantic.text.display.font-family": "heading",
      "semantic.text.heading-1.font-family": "heading",
      "semantic.text.heading-2.font-family": "heading",
      "semantic.text.heading-3.font-family": "heading",
      "semantic.text.body.font-family": "body",
      "semantic.text.body-sm.font-family": "body",
      "semantic.text.caption.font-family": "body",
