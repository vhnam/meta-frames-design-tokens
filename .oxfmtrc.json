{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "all",
  "tabWidth": 2,
  "overrides": [
    {
      "files": ["**/*.ts"],
      "options": {
        "singleQuote": true
      }
    }
  ],
  "ignorePatterns": ["tokens/**", "pnpm-lock.yaml"]
}
